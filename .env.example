DATABASE_URL=postgres://convite:convite@localhost:5432/convite
DATABASE_URL_TEST=postgres://convite:convite@localhost:5432/convite_test
AUTH_SECRET=
APP_URL=http://localhost:3000
FEATURES=
LOG_LEVEL=info
# local: docker compose --profile whatsapp up -d (then EVOLUTION_URL=http://localhost:8080,
# EVOLUTION_API_KEY=dev-evolution-key); production uses the Railway private URL
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=convite-xv
# automatic WhatsApp reminders (in-process dispatcher); "false" disables it
DISPATCHER_ENABLED=
# gift photos: Railway bucket in production (all five set); without them, files go to .data/media
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_ENDPOINT=
MEDIA_DIR=
