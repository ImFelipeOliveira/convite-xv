DATABASE_URL=postgres://convite:convite@localhost:5432/convite
DATABASE_URL_TEST=postgres://convite:convite@localhost:5432/convite_test
AUTH_SECRET=
APP_URL=http://localhost:3000
FEATURES=
LOG_LEVEL=info
# local: docker compose --profile whatsapp up -d (then EVOLUTION_URL=http://localhost:8080,
# EVOLUTION_API_KEY=dev-evolution-key); production uses the Railway private URL
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=convite-xv
# automatic WhatsApp reminders (in-process dispatcher); "false" disables it
DISPATCHER_ENABLED=
# Pix via Asaas (all optional: without ASAAS_API_KEY the Pix section shows "Pix indisponível no momento.")
# The key starts with "$": wrap it in SINGLE quotes ('$aact_...') so it is not expanded as a variable.
ASAAS_API_KEY=
# sandbox (https://api-sandbox.asaas.com/v3) | production (https://api.asaas.com/v3)
ASAAS_ENV=sandbox
# token configured on the Asaas webhook (sent back in the asaas-access-token header)
ASAAS_WEBHOOK_TOKEN=
# tests / fake server only: overrides the ASAAS_ENV URL
ASAAS_BASE_URL=
# Asaas refuses PIX charges for a customer without CPF, so by default each payer gives a CPF (sent to
# Asaas only, never stored). "false" = one generic customer without CPF.
ASAAS_REQUIRE_PAYER_CPF=
